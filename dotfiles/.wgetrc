# Keep global wget behavior conservative. Options that change filenames,
# ignore robots.txt, or add noisy headers are better passed per command.

# Do not go up in the directory structure when downloading recursively.
no_parent = on

# Wait 60 seconds before timing out. This applies to DNS, connect, and read timeouts.
timeout = 60

# Retry a few times when a download fails, but do not use wget's noisy default of 20 tries.
tries = 3

# Retry even when the connection was refused; useful for services that are still starting.
retry_connrefused = on

# Disabled on purpose:
# - timestamping changes overwrite/skip behavior for normal downloads.
# - trust_server_names lets redirects choose local filenames.
# - follow_ftp is rarely useful now and can surprise recursive downloads.
# - adjust_extension silently renames files based on Content-Type.
# - robots = off ignores crawler policy and should be explicit per mirror job.
# - server_response = on is too noisy for a global default.
#timestamping = on
#trust_server_names = on
#follow_ftp = on
#adjust_extension = on
#robots = off
#server_response = on
