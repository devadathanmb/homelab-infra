# Follow redirects, but keep a hard cap so redirect loops fail quickly.
location
max-redirs = 10

# Show a compact progress bar for interactive downloads.
progress-bar

# Treat HTTP 4xx/5xx as failures while still printing the response body.
# This avoids hiding useful API error messages during debugging.
fail-with-body
show-error

# Fail fast when a server cannot be reached.
# Do not set a global max-time: that can break large or slow downloads.
connect-timeout = 10

# Ask for compressed responses when the server supports them.
compressed
